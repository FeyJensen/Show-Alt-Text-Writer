{
  "manifest_version": 3,
  "name": "Alt Text Generator for Showit",
  "version": "1.0.0",
  "description": "Automatically generates AI-powered alt text for images without alt attributes on Showit.",
  "permissions": [
    "scripting",
    "activeTab",
    "storage",
    "tabCapture"
  ],
  "host_permissions": [
    "https://*.showit.co/*",
    "https://*.showit.com/*",
    "https://static.showit.co/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Generate Alt Text"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.showit.co/*", "https://*.showit.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_page": "options.html"
}
